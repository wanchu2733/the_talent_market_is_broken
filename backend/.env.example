# Пример переменных окружения — скопируйте в .env
DATABASE_URL=postgresql+asyncpg://postgres:secret_password_2026@db:5432/skill_market
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini

# Локальная LLM для чата (Ollama) — офлайн, без OpenAI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# GitHub токен для расширенного лимита API при сборе профиля по email
GITHUB_TOKEN=

# ─── DACH-источники (Германия / Австрия / Швейцария) ───

# Proxycurl: структурированные данные LinkedIn + XING (лучшее решение для Европы)
PROXYCURL_API_KEY=your-proxycurl-api-key

# Hunter.io: верификация корпоративных email-адресов
HUNTER_API_KEY=your-hunter-api-key

# Stack Exchange (Stack Overflow): репутация и top-теги (key опционален)
STACKEXCHANGE_KEY=
